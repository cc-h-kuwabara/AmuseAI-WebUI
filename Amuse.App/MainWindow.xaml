<CommonControls:WindowMainBase x:Class="Amuse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Amuse.App"
        xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
        xmlns:CoreViews="clr-namespace:Amuse.App.Views;assembly=Amuse.Core"
        xmlns:Views="clr-namespace:Amuse.App.Views"
        xmlns:Controls="clr-namespace:Amuse.App.Controls"
        RenderOptions.BitmapScalingMode="Fant"
        RenderOptions.ClearTypeHint="Enabled"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Style="{StaticResource WindowHeadless}"
        Title="{x:Static local:App.AppDisplayName}"
        MinWidth="1280"
        MinHeight="720"
        mc:Ignorable="d"
        x:Name="UI"
        Opacity="0">
    <CommonControls:WindowMainBase.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </CommonControls:WindowMainBase.Triggers>

    <DockPanel DataContext="{Binding ElementName=UI}">

        <DockPanel.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Settings.UIScale}" ScaleY="{Binding Settings.UIScale}" />
        </DockPanel.LayoutTransform>

        <!--Main Menu-->
        <Grid DockPanel.Dock="Top" WindowChrome.IsHitTestVisibleInChrome="True">
            <DockPanel  Height="34" Margin="0,0,1,0">

                <!--Logo-->
                <DockPanel DockPanel.Dock="Left" Width="290" >
                    <StackPanel  DockPanel.Dock="Left" Margin="0,0,0,0" Orientation="Horizontal" IsHitTestVisible="False" >
                        <Image Source="/Images/Amuse-Logo-Long-256.png" Stretch="Uniform"  HorizontalAlignment="Left" Margin="4,2,0,2" />
                        <TextBlock Text="{x:Static local:App.AppVersionDisplay}" Style="{StaticResource FieldTextBlockStyle}" FontSize="10" Margin="2,14,0,0" Opacity=".7"/>
                    </StackPanel>
                    <Grid>
                        <Button HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" ToolTip="{CommonControls:Localize UpdateAvailable}" Command="{Binding UpdateCommand, Source={x:Static Application.Current}}" Style="{StaticResource TransparentButton}" Visibility="{Binding Settings.IsUpdateAvailable, Converter={StaticResource BooleanToHiddenConverter}}">
                            <StackPanel Orientation="Horizontal" Opacity=".8">
                                <CommonControls:FontAwesome Icon="f30f" IconStyle="Light" Color="{StaticResource SuccessColour}" Margin="3,0" Size="14" />
                                <TextBlock Text="{CommonControls:Localize NewVersion}" Foreground="{StaticResource SuccessColour}" Margin="1,0,0,0" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </DockPanel>

                <!--Window Options-->
                <Grid DockPanel.Dock="Right" Width="290" >
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                        <CommonControls:IconButton 
                            Width="40"
                            Icon="f013" 
                            IconStyle="Solid"
                            FontWeight="Bold"
                            TextOpacity=".8"
                            IconColor="{StaticResource AccentColour2}"
                            Command="{Binding NavigateCategoryCommand}" 
                            CommandParameter="{x:Static CoreViews:ViewCategory.Settings}"
                            IsSelected="{Binding ViewCategory, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Settings}">
                        </CommonControls:IconButton>
                        <UniformGrid  Columns="3" >
                            <Button Command="{Binding MinimizeCommand}" Padding="10,1" >
                                <CommonControls:FontAwesome Icon="f2d1" />
                            </Button>
                            <Grid>
                                <Button Command="{Binding RestoreCommand}" Padding="10,1" Visibility="{Binding WindowState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Maximized}">
                                    <CommonControls:FontAwesome Icon="f2d2" />
                                </Button>
                                <Button Command="{Binding MaximizeCommand}" Padding="10,1" Visibility="{Binding WindowState, Converter={StaticResource InverseEnumToVisibilityConverter}, ConverterParameter=Maximized}">
                                    <CommonControls:FontAwesome Icon="f2d0" />
                                </Button>
                            </Grid>
                            <Button x:Name="CloseButton" Command="{Binding CloseCommand}" Padding="12,0" >
                                <CommonControls:FontAwesome Icon="f00d" />
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Grid>

                <!--Categories-->
                <UniformGrid Rows="1" >
                    <CommonControls:IconButton 
                        Text="{CommonControls:Localize Image}" 
                        Icon="f03e" 
                        IconMargin="0,-3,0,0"
                        Style="{StaticResource MenuIconButton}"
                        Command="{Binding NavigateCategoryCommand}" 
                        CommandParameter="{x:Static CoreViews:ViewCategory.Image}"
                        IsSelected="{Binding ViewCategory, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Image}">
                    </CommonControls:IconButton>
                    <CommonControls:IconButton 
                        Text="{CommonControls:Localize Video}" 
                        Icon="f008" 
                        IconMargin="0,-3,0,0"
                        Style="{StaticResource MenuIconButton}"
                        Command="{Binding NavigateCategoryCommand}" 
                        CommandParameter="{x:Static CoreViews:ViewCategory.Video}"
                        IsSelected="{Binding ViewCategory, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Video}">
                    </CommonControls:IconButton>
                    <CommonControls:IconButton 
                        Text="{CommonControls:Localize Audio}" 
                        Icon="f001" 
                        IconMargin="0,-1,0,0"
                        Style="{StaticResource MenuIconButton}"
                        Command="{Binding NavigateCategoryCommand}" 
                        CommandParameter="{x:Static CoreViews:ViewCategory.Audio}"
                        IsSelected="{Binding ViewCategory, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Audio}">
                    </CommonControls:IconButton>
                    <CommonControls:IconButton 
                        Text="{CommonControls:Localize Text}" 
                        Icon="f893" 
                        IconMargin="0,-2,0,0"
                        IconStyle="Regular"
                        Style="{StaticResource MenuIconButton}"
                        Command="{Binding NavigateCategoryCommand}" 
                        CommandParameter="{x:Static CoreViews:ViewCategory.Text}"
                        IsSelected="{Binding ViewCategory, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Text}">
                    </CommonControls:IconButton>
                    <CommonControls:IconButton 
                        Text="{CommonControls:Localize Gallery}" 
                        Icon="e228" 
                        IconMargin="0,-2,0,0"
                        Style="{StaticResource MenuIconButton}"
                        Command="{Binding NavigateCommand}" 
                        CommandParameter="{x:Static CoreViews:View.Gallery}"
                        IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Gallery}">
                    </CommonControls:IconButton>
                    <CommonControls:IconButton 
                        Text="{CommonControls:Localize Models}" 
                        Icon="f5fd" 
                        IconMargin="0,-2,0,0"
                        Style="{StaticResource MenuIconButton}"
                        Command="{Binding NavigateCommand}" 
                        CommandParameter="{x:Static CoreViews:View.Models}"
                        IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Models}">
                    </CommonControls:IconButton>
                </UniformGrid>

            </DockPanel>
        </Grid>


        <!--Sub Menu-->
        <Border  DockPanel.Dock="Left"  Margin="4,8,0,0" >
            <DockPanel>

                <!--SystemInfo-->
                <Grid  DockPanel.Dock="Bottom" Margin="0,0,0,4">
                    <Controls:SystemInfoControl />
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewCategory}" Value="Settings">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ViewCategory}" Value="Other">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                </Grid>

                <Grid>

                    <!--Settings-->
                    <Grid Visibility="{Binding ViewCategory, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Settings}">
                        <UniformGrid Columns="1" VerticalAlignment="Top" Margin="20,20,0,20">
                            <CommonControls:IconButton 
                                Height="40"
                                Icon="f1de"
                                Text="{CommonControls:Localize General}" 
                                IconSize="18"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Orientation="Horizontal"
                                Alignment="Left"
                                Placement="Right"
                                TextOpacity=".9"
                                IconMargin="20,0,4,0"
                                IconColor="{StaticResource AccentColour2}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.General}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=General}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Environment}" 
                                Icon="f233"
                                IconSize="18"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Orientation="Horizontal"
                                Alignment="Left"
                                Placement="Right"
                                TextOpacity=".9"
                                IconMargin="20,0,6,0"
                                IconColor="{StaticResource AccentColour2}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.Environment}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Environment}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize LLM}" 
                                Icon="e699"
                                IconSize="18"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Orientation="Horizontal"
                                Alignment="Left"
                                Placement="Right"
                                TextOpacity=".9"
                                IconMargin="20,0,6,0"
                                IconColor="{StaticResource AccentColour2}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.Language}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Language}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Diffusion}" 
                                Icon="e4e2"
                                IconSize="18"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Orientation="Horizontal"
                                Alignment="Left"
                                Placement="Right"
                                TextOpacity=".9"
                                IconMargin="20,0,4,0"
                                IconColor="{StaticResource AccentColour2}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.Diffusion}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Diffusion}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize LoraAdapter}" 
                                Icon="f1e0"
                                IconSize="18"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Orientation="Horizontal"
                                Alignment="Left"
                                Placement="Right"
                                TextOpacity=".9"
                                IconMargin="20,0,5,0"
                                IconColor="{StaticResource AccentColour2}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.LoraAdapter}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=LoraAdapter}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize ControlNet}" 
                                Icon="f78a"
                                IconSize="18"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Orientation="Horizontal"
                                Alignment="Left"
                                Placement="Right"
                                TextOpacity=".9"
                                IconMargin="17,0,3,0"
                                IconColor="{StaticResource AccentColour2}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.ControlNet}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ControlNet}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Extractor}" 
                                Icon="f302"
                                IconSize="18"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Orientation="Horizontal"
                                Alignment="Left"
                                Placement="Right"
                                TextOpacity=".9"
                                IconMargin="20,0,3,0"
                                IconColor="{StaticResource AccentColour2}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.Extract}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Extract}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Upscaler}" 
                                Icon="f424"
                                IconSize="18"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Orientation="Horizontal"
                                Alignment="Left"
                                Placement="Right"
                                TextOpacity=".8"
                                IconMargin="20,0,6,0"
                                IconColor="{StaticResource AccentColour2}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.Upscale}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Upscale}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Components}" 
                                Icon="e479"
                                IconSize="18"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Orientation="Horizontal"
                                Alignment="Left"
                                Placement="Right"
                                TextOpacity=".8"
                                IconMargin="20,0,8,0"
                                IconColor="{StaticResource AccentColour2}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.Component}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Component}">
                            </CommonControls:IconButton>
                        </UniformGrid>

                        <Grid Width="180" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20,0,0,20">
                            <DockPanel Opacity=".7">
                                <CommonControls:FontAwesome DockPanel.Dock="Top" Icon="f535" Size="35" IconStyle="SharpThin" HorizontalAlignment="Left" />
                                <TextBlock DockPanel.Dock="Top" Text="Made in New Zealand" />
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom"  UseLayoutRounding="True" Orientation="Horizontal">
                                    <TextBlock Text="Created By: " FontStyle="Italic"  FontSize="10" VerticalAlignment="Center" Margin="0,2,0,0" />
                                    <TextBlock Text="sa_ddam213" Foreground="{StaticResource AccentColour2}"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Grid>

                    <!--Image-->
                    <Grid Visibility="{Binding ViewCategory, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Image}">
                        <UniformGrid Columns="1" VerticalAlignment="Top" >
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_TextToImage}" 
                                Icon="f894"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.TextToImage}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=TextToImage}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_ImageToImage}" 
                                Icon="f03e"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.ImageToImage}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ImageToImage}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_ImageEdit}" 
                                Icon="f4a4"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.ImageEdit}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ImageEdit}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_ImageInpaint}" 
                                Icon="f044"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.ImageInpaint}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ImageInpaint}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_PaintToImage}" 
                                Icon="f1fc"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.PaintToImage}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=PaintToImage}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_ImageExtract}" 
                                Icon="f302"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.ImageExtract}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ImageExtract}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_ImageUpscale}" 
                                Icon="f424"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.ImageUpscale}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ImageUpscale}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_ImageCompose}" 
                                Icon="f5fd"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.ImageCompose}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ImageCompose}">
                            </CommonControls:IconButton>
                        </UniformGrid>
                    </Grid>

                    <!--Video-->
                    <Grid Visibility="{Binding ViewCategory, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Video}">
                        <UniformGrid Columns="1" VerticalAlignment="Top" >
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_TextToVideo}" 
                                Icon="f894"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.TextToVideo}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=TextToVideo}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_ImageToVideo}" 
                                Icon="f03e"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.ImageToVideo}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ImageToVideo}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_VideoToVideo}" 
                                Icon="f008"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.VideoToVideo}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=VideoToVideo}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_FrameToFrame}" 
                                Icon="e17a"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.FrameToFrame}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=FrameToFrame}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_VideoExtract}" 
                                Icon="f302"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.VideoExtract}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=VideoExtract}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_VideoUpscale}" 
                                Icon="f424"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.VideoUpscale}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=VideoUpscale}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_VideoInterpolate}" 
                                Icon="e4a2"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.VideoInterpolate}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=VideoInterpolate}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_VideoCompose}" 
                                Icon="e131"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.VideoCompose}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=VideoCompose}">
                            </CommonControls:IconButton>
                        </UniformGrid>
                    </Grid>


                    <!--Audio-->
                    <Grid Visibility="{Binding ViewCategory, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Audio}">
                        <UniformGrid Columns="1" VerticalAlignment="Top" >
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_TextToMusic}" 
                                Icon="f8c9"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.TextToMusic}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=TextToMusic}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_TextToAudio}" 
                                Icon="f894"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.TextToAudio}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=TextToAudio}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_AudioToText}" 
                                Icon="f001"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.AudioToText}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=AudioToText}">
                            </CommonControls:IconButton>
                        </UniformGrid>
                    </Grid>


                    <!--Text-->
                    <Grid Visibility="{Binding ViewCategory, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Text}">
                        <UniformGrid Columns="1" VerticalAlignment="Top" >
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_ImageToText}" 
                                Icon="f03e"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.ImageToText}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ImageToText}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_TextInstruct}" 
                                Icon="e1e3"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.TextInstruct}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=TextInstruct}">
                            </CommonControls:IconButton>
                            <CommonControls:IconButton 
                                Text="{CommonControls:Localize Menu_TextConverse}" 
                                Icon="e1e7"
                                Style="{StaticResource SubmenuIconButton}"
                                Command="{Binding NavigateCommand}" 
                                CommandParameter="{x:Static CoreViews:View.TextConverse}"
                                IsSelected="{Binding View, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=TextConverse}">
                            </CommonControls:IconButton>
                        </UniformGrid>
                    </Grid>
                </Grid>
            </DockPanel>

            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewCategory}" Value="Other">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>


        <!--History-->
        <Border Panel.ZIndex="0" BorderBrush="{StaticResource DefaultBorderColor}" Opacity=".8" >
            <Controls:HistoryControl 
                x:Name="MainHistoryControl"
                ItemSource="{Binding HistoryService.HistoryCollection}"
                RemoveItemCommand="{Binding RemoveHistoryItemCommand}" 
                PreviewItemCommand="{Binding PreviewHistoryItemCommand}">
                <Controls:HistoryControl.Style>
                    <Style TargetType="{x:Type Controls:HistoryControl}">
                        <Setter Property="Orientation" Value="{Binding Settings.HistoryOrientation}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding View, ElementName=UI}" Value="TextInstruct">
                                <Setter Property="Orientation" Value="Vertical"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding View, ElementName=UI}" Value="TextConverse">
                                <Setter Property="Orientation" Value="Vertical"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Controls:HistoryControl.Style>
            </Controls:HistoryControl>
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Margin" Value="7,0,0,0"/>
                    <Setter Property="BorderThickness" Value="0,2,0,0"/>
                    <Setter Property="DockPanel.Dock" Value="Bottom"/>
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Orientation, ElementName=MainHistoryControl}" Value="Vertical">
                            <Setter Property="Width" Value="122"/>
                            <Setter Property="Margin" Value="0,8,0,0"/>
                            <Setter Property="DockPanel.Dock" Value="Right"/>
                            <Setter Property="BorderThickness" Value="0,0,0,0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ViewCategory, ElementName=UI}" Value="Settings">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ViewCategory, ElementName=UI}" Value="Other">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>


        <!--View Container-->
        <CommonControls:ViewContainer Navigation="{Binding Navigation}" NavigationUIVisibility="Hidden" />

    </DockPanel>
</CommonControls:WindowMainBase>

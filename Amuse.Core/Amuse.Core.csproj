<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWPF Condition="'$(AmusePortable)' != 'true'">true</UseWPF>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <!-- Keep source paths stable for the desktop app; these files now compile only here.
       WPF remains a Windows media adapter dependency, not an application/window. -->
  <ItemGroup>
    <ProjectReference Include="..\Amuse.Common\Amuse.Common.csproj" />
    <Compile Include="..\Amuse.App\Common\*.cs" Link="Common\%(Filename)%(Extension)" />
    <Compile Include="..\Amuse.App\Backend\*.cs" Link="Backend\%(Filename)%(Extension)" />
    <Compile Include="..\Amuse.App\Tools\*.cs" Link="Tools\%(Filename)%(Extension)" />
    <Compile Include="..\Amuse.App\Services\*.cs" Exclude="..\Amuse.App\Services\MarkdownConverter.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\Amuse.App\Settings.cs;..\Amuse.App\SettingsManager.cs;..\Amuse.App\Json.cs;..\Amuse.App\Extensions.cs;..\Amuse.App\HuggingFace.cs;..\Amuse.App\Views\View.cs" />
    <Compile Include="..\Amuse.App\Resources\*.Designer.cs" Link="Resources\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Amuse.App\Resources\*.resx" Link="Resources\%(Filename)%(Extension)">
      <LogicalName>Amuse.App.Resources.%(Filename).resources</LogicalName>
    </EmbeddedResource>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="System.Linq.Async" Version="7.0.1" />
    <PackageReference Include="System.Management" Version="10.0.13" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="WebLookup" Version="0.3.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug' and '$(AmusePortable)' != 'true'">
    <ProjectReference Include="..\..\TensorStack.WPF\TensorStack.WPF.csproj" />
    <ProjectReference Include="..\..\TensorStack.Media\TensorStack.Media.csproj" />
    <ProjectReference Include="..\..\TensorStack.OnnxRuntime\TensorStack.OnnxRuntime.csproj" />
    <ProjectReference Include="..\..\TensorStack.OnnxRuntime.Vision\TensorStack.OnnxRuntime.Vision.csproj" />
    <ProjectReference Include="..\..\TensorStack.OnnxRuntime.LLM\TensorStack.OnnxRuntime.LLM.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug' and '$(AmusePortable)' != 'true'">
    <PackageReference Include="TensorStack.WPF" Version="$(PackageVersion)" />
    <PackageReference Include="TensorStack.Media" Version="$(PackageVersion)" />
    <PackageReference Include="TensorStack.OnnxRuntime" Version="$(PackageVersion)" />
    <PackageReference Include="TensorStack.OnnxRuntime.Vision" Version="$(PackageVersion)" />
    <PackageReference Include="TensorStack.OnnxRuntime.LLM" Version="$(PackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(AmusePortable)' == 'true'">
    <ProjectReference Include="../ThirdParty/TensorStack/TensorStack.Headless/TensorStack.Headless.csproj" />
    <ProjectReference Include="../ThirdParty/TensorStack/TensorStack.OnnxRuntime.Vision/TensorStack.OnnxRuntime.Vision.csproj" />
    <ProjectReference Include="../ThirdParty/TensorStack/TensorStack.OnnxRuntime.LLM/TensorStack.OnnxRuntime.LLM.csproj" />
    <Compile Remove="../Amuse.App/Services/HardwareService.cs;../Amuse.App/Services/HistoryService.cs;../Amuse.App/Common/StatisticsModel.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(AmusePortable)' != 'true'"><Compile Remove="Portable/**/*.cs" /></ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>AmuseHost.OnnxRuntime</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <Configurations>Debug;Release;Release_Installer</Configurations>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <BaseOutputPath>..\Amuse.App\bin</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**" />
    <EmbeddedResource Remove="bin\**" />
    <None Remove="bin\**" />
  </ItemGroup>

  <!--Projects-->
  <ItemGroup>
    <ProjectReference Include="..\Amuse.Common\Amuse.Common.csproj" />
  </ItemGroup>

  <!--Common-->
  <ItemGroup>
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!--Debug-->
  <ItemGroup Condition="'$(Configuration)' == 'Debug' and '$(AmusePortable)' != 'true'">
    <ProjectReference Include="..\..\TensorStack.OnnxRuntime\TensorStack.OnnxRuntime.csproj" />
    <ProjectReference Include="..\..\TensorStack.OnnxRuntime.LLM\TensorStack.OnnxRuntime.LLM.csproj" />
  </ItemGroup>

  <!--Release-->
  <ItemGroup Condition="('$(Configuration)' == 'Release' OR '$(Configuration)' == 'Release_Installer') and '$(AmusePortable)' != 'true'">
    <PackageReference Include="TensorStack.OnnxRuntime" Version="$(PackageVersion)" />
    <PackageReference Include="TensorStack.OnnxRuntime.LLM" Version="$(PackageVersion)" />
  </ItemGroup>

  <!--Images-->
  <ItemGroup>
    <Resource Include="Icon.ico" />
  </ItemGroup>

<ItemGroup Condition="'$(AmusePortable)' == 'true'"><ProjectReference Include="../ThirdParty/TensorStack/TensorStack.OnnxRuntime.LLM/TensorStack.OnnxRuntime.LLM.csproj"/><ProjectReference Include="../ThirdParty/TensorStack/TensorStack.OnnxRuntime.Vision/TensorStack.OnnxRuntime.Vision.csproj"/><ProjectReference Include="../ThirdParty/TensorStack/TensorStack.Media/TensorStack.Media.csproj"/></ItemGroup></Project>

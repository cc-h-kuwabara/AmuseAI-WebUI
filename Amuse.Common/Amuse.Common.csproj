<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
    <Configurations>Debug;Release;Release_Installer</Configurations>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--Common-->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

  <!--Debug-->
  <ItemGroup Condition="'$(Configuration)' == 'Debug' and '$(AmusePortable)' != 'true'">
    <ProjectReference Include="..\..\TensorStack.Common\TensorStack.Common.csproj" />
  </ItemGroup>

  <!--Release-->
  <ItemGroup Condition="('$(Configuration)' == 'Release' OR '$(Configuration)' == 'Release_Installer') and '$(AmusePortable)' != 'true'">
    <PackageReference Include="TensorStack.Common" Version="$(PackageVersion)" />
  </ItemGroup>

<ItemGroup Condition="'$(AmusePortable)' == 'true'"><ProjectReference Include="../ThirdParty/TensorStack/TensorStack.Common/TensorStack.Common.csproj"/></ItemGroup></Project>
